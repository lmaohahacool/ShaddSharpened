<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Shaft.Game</RootNamespace>
    <AssemblyName>ShaftAdditionality</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Shaft.Engine\Shaft.Engine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL.Extensions.Creative" Version="2.23.0" />
    <!-- Native OpenAL implementation (soft_oal.dll / libopenal), so audio works out of the box
         on a clean machine with no drivers installed. -->
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="MP3Sharp" Version="1.0.5" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>
  <ItemGroup>
    <!-- Ship the JS assets alongside the executable so the port runs from a clean clone.
         ExcludeFromSingleFile keeps them as loose files in single-file publishes: the game
         loads them with plain file IO, so they must sit on disk next to the exe (and the
         win-x64 bundler otherwise swallows the binary ones into the exe). -->
    <None Include="..\..\dist\**\*.*" LinkBase="dist\" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
